*{box-sizing:border-box;margin:0;padding:0;scrollbar-width:thin;scrollbar-color:rgba(212, 216, 223, 1) transparent;}/*!sc*/
html{font-size:10px;background-color:rgba(249, 249, 251, 1);}/*!sc*/
body{background-color:rgba(249, 249, 251, 1);}/*!sc*/
body,a,button{font-family:Source Sans Pro,sans-serif;}/*!sc*/
p{font-size:1.6rem;margin-bottom:0;line-height:2.4rem;}/*!sc*/
ul{list-style:none;}/*!sc*/
small{font-size:1.4rem;}/*!sc*/
a,button{cursor:pointer;}/*!sc*/
a{color:rgba(17, 83, 228, 1);}/*!sc*/
button{border:none;background:transparent;}/*!sc*/
input::-webkit-input-placeholder{font-family:Source Sans Pro,sans-serif;}/*!sc*/
input::-moz-placeholder{font-family:Source Sans Pro,sans-serif;}/*!sc*/
:is(h1, h2, h3, h4){font-family:Ubuntu;font-weight:500;margin-bottom:2rem;color:rgba(21, 28, 43, 1);}/*!sc*/
:is(h5, h6){font-family:Source Sans Pro,sans-serif;font-weight:400;margin-bottom:2rem;color:rgba(82, 90, 106, 1);}/*!sc*/
h1{font-size:3.2rem;}/*!sc*/
@media screen and (min-width: 768px){h1{font-size:4.4rem;}}/*!sc*/
@media screen and (min-width: 1024px){h1{font-size:5.4rem;}}/*!sc*/
h2{font-size:2.4rem;}/*!sc*/
@media screen and (min-width: 768px){h2{font-size:3.2rem;}}/*!sc*/
h3{font-size:2rem;}/*!sc*/
@media screen and (min-width: 1024px){h3{font-size:2.4rem;}}/*!sc*/
h4{font-size:1.8rem;}/*!sc*/
h5{font-size:2rem;line-height:3rem;}/*!sc*/
@media screen and (min-width: 1024px){h5{font-size:2.4rem;line-height:3.5rem;}}/*!sc*/
h6{font-size:2rem;}/*!sc*/
@media screen and (min-width: 1024px){h6{font-size:2.2rem;}}/*!sc*/
.no-scroll{overflow:hidden;height:100%;}/*!sc*/
@media screen and (max-width: 768px){.mobile-no-scroll{overflow:hidden;height:100%;}}/*!sc*/
::-webkit-scrollbar{width:8px;height:8px;}/*!sc*/
::-webkit-scrollbar-track{background-color:transparent;}/*!sc*/
::-webkit-scrollbar-thumb{background-color:rgba(212, 216, 223, 1);border-radius:1rem;}/*!sc*/
.react-datepicker-popper[data-placement^='bottom'] .react-datepicker__triangle,.react-datepicker-popper[data-placement^='top'] .react-datepicker__triangle,.react-datepicker-popper[data-placement^='left'] .react-datepicker__triangle,.react-datepicker-popper[data-placement^='right'] .react-datepicker__triangle{color:rgba(255, 255, 255, 1);fill:rgba(255, 255, 255, 1);}/*!sc*/
