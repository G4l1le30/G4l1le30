var isForcedDarkTheme=!isForcedLightTheme&&!isUserThemePage&&forcedDarkThemePages.some(function(page){return currentPath===page||currentPath.startsWith(page+'/');});
var bgColor;
if(isForcedLightTheme){bgColor='#f9f9fb';}
else if(isForcedDarkTheme){bgColor='#151c2b';}
else{var cachedTheme='';try{cachedTheme=(localStorage.getItem('cachedTheme')||'').trim();}catch(e){}
if(cachedTheme==='light'){bgColor='#f9f9fb';}
else if(cachedTheme==='dark'){bgColor='#151c2b';}
else{var prefersDark=window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches;bgColor=prefersDark?'#151c2b':'#f9f9fb';}}
document.documentElement.style.backgroundColor=bgColor;
document.body.style.backgroundColor=bgColor;
})();</script><link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&amp;family=Source+Sans+Pro:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,400&amp;family=Bungee&amp;family=Nanum+Pen+Script&amp;family=Playfair+Display:wght@400;700&amp;family=Chakra+Petch:wght@600;700&amp;family=Ubuntu+Mono&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=The+Nautigal:wght@400;700&amp;display=swap" rel="stylesheet"/><style id="__THM_AUTH_PENDING_STYLE__">[data-thm-auth-pending="true"] [data-thm-auth-chrome="true"]{visibility:hidden;}</style><style id="__THM_DOCUMENT_OVERFLOW_STYLE__">html{overflow-x:clip}</style><script id="__THM_AUTH_PENDING__">try{if(document.cookie.split(';').some(function(cookie){return cookie.trim().indexOf('logged-in-hint=')===0;})){document.documentElement.setAttribute('data-thm-auth-pending','true');}}catch{}</script><script id="intercom-stub">(function(){
