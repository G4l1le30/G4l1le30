var forcedDarkThemePages=['/soc-sim','/business','/business-trial','/affiliates','/premium/welcome','/max/welcome','/retention/processing-cancellation','/retention/processing-offer','/influencer','/compare/immersive-labs','/students','/compare/hackthebox','/compare/hackthebox-enterprise','/beginner-path','/free-rooms','/honeynet-collapse','/hack2win','/christmas-2023','/christmas-2024','/adventofcyber25','/certifications','/certification','/tabletop-exercises','/ttx','/threat-hunting','/badr','/sim-welcome','/dashboard/modules','/ctf-builder','/debrief','/jr-penetration-tester','/hacktivities','/cyber-security-careers/quiz','/threat-hunting-sim','/live-breach','/hackfinity','/industrial-intrusion','/thecoldstart','/socl2-event','/the-red-raffle','/room','/onboarding','/welcome','/study-cohorts','/study-squads'];
